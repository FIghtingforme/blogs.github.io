        &lt;h3&gt;搭建服务器的FTP文件夹挂载在win上&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;搭建服务器的ftp文件夹挂载在win上&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e6%90%ad%e5%bb%ba%e6%9c%8d%e5%8a%a1%e5%99%a8%e7%9a%84ftp%e6%96%87%e4%bb%b6%e5%a4%b9%e6%8c%82%e8%bd%bd%e5%9c%a8win%e4%b8%8a&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;!-- raw HTML omitted --&gt;
&lt;h4&gt;简单介绍：&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;简单介绍&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e7%ae%80%e5%8d%95%e4%bb%8b%e7%bb%8d&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;h5&gt;FTP（VSFTP）&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;ftpvsftp&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#ftpvsftp&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h5&gt;&lt;h5&gt;类unix系统使用的FTP服务器软件&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;类unix系统使用的ftp服务器软件&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e7%b1%bbunix%e7%b3%bb%e7%bb%9f%e4%bd%bf%e7%94%a8%e7%9a%84ftp%e6%9c%8d%e5%8a%a1%e5%99%a8%e8%bd%af%e4%bb%b6&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h5&gt;&lt;!-- raw HTML omitted --&gt;
&lt;h5&gt;安全，高速，稳定&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;安全高速稳定&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e5%ae%89%e5%85%a8%e9%ab%98%e9%80%9f%e7%a8%b3%e5%ae%9a&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h5&gt;&lt;h6&gt;vim /etc/services    查端口&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;vim-etcservices----查端口&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#vim-etcservices----%e6%9f%a5%e7%ab%af%e5%8f%a3&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;h6&gt;20  传数据；21  传指令&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;20--传数据21--传指令&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#20--%e4%bc%a0%e6%95%b0%e6%8d%ae21--%e4%bc%a0%e6%8c%87%e4%bb%a4&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;!-- raw HTML omitted --&gt;
&lt;h5&gt;FTP会话通道：&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;ftp会话通道&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#ftp%e4%bc%9a%e8%af%9d%e9%80%9a%e9%81%93&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h5&gt;&lt;h6&gt;20数据通道：正文&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;20数据通道正文&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#20%e6%95%b0%e6%8d%ae%e9%80%9a%e9%81%93%e6%ad%a3%e6%96%87&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;h6&gt;21控制通道：敲门，输密码，发指令&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;21控制通道敲门输密码发指令&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#21%e6%8e%a7%e5%88%b6%e9%80%9a%e9%81%93%e6%95%b2%e9%97%a8%e8%be%93%e5%af%86%e7%a0%81%e5%8f%91%e6%8c%87%e4%bb%a4&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;!-- raw HTML omitted --&gt;
&lt;h6&gt;主动模式：&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;主动模式&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e4%b8%bb%e5%8a%a8%e6%a8%a1%e5%bc%8f&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;p&gt;C随机开高位端口&amp;amp;发给S，Server通过20端口与Client连接&amp;amp;发数据&lt;/p&gt;
&lt;h6&gt;被动模式(passive)： 相对的&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;被动模式passive-相对的&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e8%a2%ab%e5%8a%a8%e6%a8%a1%e5%bc%8fpassive-%e7%9b%b8%e5%af%b9%e7%9a%84&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h6&gt;&lt;p&gt;S开放随机高位端口&amp;amp;发给C,然后等待Client连接&lt;/p&gt;
&lt;!-- raw HTML omitted --&gt;
&lt;h4&gt;配置实现：&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;配置实现&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#%e9%85%8d%e7%bd%ae%e5%ae%9e%e7%8e%b0&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;此章节的永久链接&#34;&gt;&lt;/a&gt;&lt;/h4&gt;&lt;div class=&#34;hextra-code-block hx:relative hx:mt-6 hx:first:mt-0 hx:group/code&#34;&gt;

&lt;div&gt;&lt;pre&gt;&lt;code&gt;dnf install vsftpd y
systemctl start vsftpd
systemctl status vsftpd

firewallcmd permanent addservice=ftp
firewallcmd reload

vim /etc/vsftpd/vsftpd.conf
local_enables=YES
write_enables=YES

setenforce 0&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;div class=&#34;hextra-code-copy-btn-container hx:opacity-0 hx:transition hx:group-hover/code:opacity-100 hx:flex hx:gap-1 hx:absolute hx:m-[11px] hx:right-0 hx:top-0&#34;&gt;
